<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JQuery_ECommerceAss</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Eduvo.Tests/**/*.cs" />
    <Content Remove="Eduvo.Tests/**" />
    <EmbeddedResource Remove="Eduvo.Tests/**" />
    <None Remove="Eduvo.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="5.0.0" />
  </ItemGroup>

</Project>
