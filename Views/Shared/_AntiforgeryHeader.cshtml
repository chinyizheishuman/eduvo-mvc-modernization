@* Renders the antiforgery token and attaches it to every jQuery AJAX request
   as a request header. Include this partial once per standalone page,
   immediately after the jQuery script tag, so tokenless AJAX POSTs stop
   being rejected with HTTP 400 by the antiforgery filter. *@
@Html.AntiForgeryToken()
<script>
    (function () {
        function install() {
            if (!window.jQuery) {
                return false;
            }
            if (window.__antiforgeryHeaderInstalled) {
                return true;
            }
            window.__antiforgeryHeaderInstalled = true;
            jQuery.ajaxSetup({
                beforeSend: function (xhr) {
                    var input = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (input && input.value) {
                        xhr.setRequestHeader('RequestVerificationToken', input.value);
                    }
                }
            });
            return true;
        }

        if (!install()) {
            document.addEventListener('DOMContentLoaded', install);
        }
    })();
</script>
