@using JQuery_ECommerceAss.Common.Pricing
@model List<JQuery_ECommerceAss.Models.Cart>
@{
    ViewData["Title"] = "Checkout";
    var appliedPromoCode = ViewBag.AppliedPromoCode as string;
    var promoDiscount = ViewBag.PromotionDiscount ?? 0m;
    var subtotal = CheckoutPricing.CalculateSubtotal(Model);
    var gst = CheckoutPricing.RoundMoney(CheckoutPricing.CalculateGst(subtotal));
    var total = subtotal + gst - promoDiscount;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/geek-lab.css" asp-append-version="true">
</head>
<body class="lab-area">
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "User")">Geek Lab</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle shopper navigation" aria-controls="navbarNav" aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "User")"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Products", "User")"><i class="fas fa-shopping-bag"></i> Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Cart", "User")"><i class="fas fa-shopping-cart"></i> Cart</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Profile", "User")"><i class="fas fa-user"></i> Profile</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container lab-page">
        <a asp-action="Cart" class="checkout-back"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to cart</a>
        <header class="lab-page-header">
            <div>
                <h1>Review your order</h1>
                <p>Checkout · Demo order</p>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null || TempData["PromoError"] != null)
        {
            <div class="alert alert-danger" role="alert">@(TempData["Error"] ?? TempData["PromoError"])</div>
        }

        <div class="row gy-3">
            <div class="col-lg-8">
                <section class="card checkout-panel" aria-labelledby="order-items-heading">
                    <h2 id="order-items-heading">Items in your order</h2>
                    @foreach (var item in Model)
                    {
                        <div class="order-item align-items-center">
                            <div class="checkout-image">
                                @if (!string.IsNullOrEmpty(item.Product?.ImagePath))
                                {
                                    <img src="@(item.Product.ImagePath.Split(',', 2)[0])" alt="">
                                }
                            </div>
                            <div>
                                <div class="fw-semibold text-break">@item.Product?.ProductName</div>
                                <small class="text-muted">RM @item.Price?.ToString("N2") × @item.Quantity?.ToString("0.##")</small>
                            </div>
                            <strong class="text-nowrap">RM @(((item.Price ?? 0) * (item.Quantity ?? 0)).ToString("N2"))</strong>
                        </div>
                    }
                </section>
            </div>

            <div class="col-lg-4">
                <section class="card checkout-summary checkout-panel" aria-labelledby="order-summary-heading">
                    <h2 id="order-summary-heading">Order summary</h2>
                    <dl class="checkout-totals">
                        <div><dt>Subtotal</dt><dd>RM @subtotal.ToString("N2")</dd></div>
                        <div><dt>GST (6%)</dt><dd>RM @gst.ToString("N2")</dd></div>
                        @if (promoDiscount > 0)
                        {
                            <div class="text-success"><dt>Promotion</dt><dd>− RM @promoDiscount.ToString("N2")</dd></div>
                        }
                        <div class="checkout-total"><dt>Total</dt><dd>RM @total.ToString("N2")</dd></div>
                    </dl>

                    <div class="bg-light p-3 rounded mb-3">
                        @if (string.IsNullOrEmpty(appliedPromoCode))
                        {
                            <form asp-action="ApplyPromoCode" method="post">
                                <label class="fw-bold mb-2" for="promoCode">Promo code</label>
                                <div class="input-group">
                                    <input type="text" name="promoCode" id="promoCode" class="form-control" placeholder="Enter code" required>
                                    <button type="submit" class="btn btn-primary">Apply</button>
                                </div>
                            </form>
                            <div class="text-center mt-2">
                                <a href="@Url.Action("MyPromotions", "User")" class="small text-primary">View My Promotions →</a>
                            </div>
                        }
                        else
                        {
                            <div class="promo-badge">
                                <i class="fas fa-check-circle" aria-hidden="true"></i> @appliedPromoCode
                                <form asp-action="RemovePromoCode" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-2">Remove</button>
                                </form>
                            </div>
                        }
                    </div>

                    <form id="paymentForm" asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="checkoutToken" value="@ViewBag.CheckoutToken">
                        <button type="submit" class="btn-pay" aria-describedby="checkout-demo-note">Place demo order</button>
                        <p class="checkout-demo-note" id="checkout-demo-note">No payment will be collected.</p>
                    </form>
                </section>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>