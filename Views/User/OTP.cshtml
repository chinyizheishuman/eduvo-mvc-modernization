@{
    ViewData["Title"] = "OTP Verification";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }

        .auth-box {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 450px;
            width: 100%;
        }

        .otp-input {
            text-align: center;
            font-size: 2rem;
            letter-spacing: 10px;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="auth-box">
        <div class="text-center mb-4">
            <div class="mb-3"><i class="fas fa-shield-alt fa-3x text-primary"></i></div>
            <h2 class="fw-bold">OTP Verification</h2>
            <p class="text-muted">Enter the 6-digit code sent to your email</p>
        </div>

        <div class="alert alert-success" id="successAlert" style="display: none;"></div>
        <div class="alert alert-danger" id="errorAlert" style="display: none;"></div>

        <form id="otpForm">
            <div class="mb-3">
                <input type="text" class="form-control otp-input" id="otpInput" name="otp" maxlength="6" placeholder="000000" required autocomplete="off">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">
                <i class="fas fa-check me-2"></i> Verify OTP
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="javascript:history.back()" class="text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        $('#otpInput').focus();
        $('#otpInput').on('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        $('#otpForm').on('submit', function(e) {
            e.preventDefault();
            const otp = $('#otpInput').val();
            if (otp.length !== 6) {
                $('#errorAlert').text('Please enter 6-digit OTP').show();
                return;
            }

            $.ajax({
                url: window.location.pathname,
                type: 'POST',
                data: { otp: otp },
                success: function(response) {
                    if (response.success) {
                        $('#successAlert').text(response.message).show();
                        setTimeout(() => {
                            window.location.href = response.redirect || '/User/Login';
                        }, 1500);
                    } else {
                        $('#errorAlert').text(response.message || 'Invalid OTP').show();
                        $('#otpInput').val('').focus();
                    }
                },
                error: function() {
                    $('#errorAlert').text('An error occurred').show();
                }
            });
        });
    </script>
</body>
</html>