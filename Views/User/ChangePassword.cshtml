@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-card" aria-labelledby="password-title">
            <div class="auth-panel">
                <div class="auth-brand">Password recovery</div>
                <h1 id="password-title">Set new password</h1>
                <p>Choose a password that is different from the previous password.</p>
                <div class="auth-alert error" id="errorAlert" role="alert"></div>
                <div class="auth-alert success" id="successAlert" role="status"></div>
                <form id="changeForm">
                    @Html.AntiForgeryToken()
                    <div class="auth-field">
                        <label class="auth-label" for="newPassword">New password</label>
                        <input class="auth-input" id="newPassword" name="newPassword"
                               type="password" autocomplete="new-password" required>
                    </div>
                    <div class="auth-field">
                        <label class="auth-label" for="confirmNewPassword">Confirm password</label>
                        <input class="auth-input" id="confirmNewPassword" name="ConfirmNewPassword"
                               type="password" autocomplete="new-password" required>
                    </div>
                    <button class="auth-button" type="submit">Change password</button>
                </form>
            </div>
        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script>
        $("#changeForm").on("submit", function (event) {
            event.preventDefault();
            const button = this.querySelector("button[type=submit]");
            button.disabled = true;
            $.ajax({
                url: '@Url.Action("ChangePassword", "User")',
                type: "POST",
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $("#errorAlert").hide();
                        $("#successAlert").text("Password changed.").show();
                        setTimeout(function () { window.location.href = '@Url.Action("Login", "User")'; }, 700);
                    } else {
                        $("#successAlert").hide();
                        $("#errorAlert").text(response.message || "Password change failed.").show();
                    }
                },
                error: function () {
                    $("#errorAlert").text("The server could not change the password.").show();
                },
                complete: function () { button.disabled = false; }
            });
        });
    </script>
</body>
</html>
