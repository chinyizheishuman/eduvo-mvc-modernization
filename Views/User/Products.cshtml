@model List<JQuery_ECommerceAss.Models.Product>
@{
    ViewData["Title"] = "Products";
    var productCount = Model.Count;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/geek-lab.css" asp-append-version="true">
</head>
<body class="lab-area">
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "User")">Geek Lab</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle shop navigation" aria-controls="navbarNav" aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "User")"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link active" aria-current="page" href="@Url.Action("Products", "User")"><i class="fas fa-shopping-bag"></i> Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Cart", "User")"><i class="fas fa-shopping-cart"></i> Cart</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MyPromotions", "User")"><i class="fas fa-tags"></i> Promotions</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Profile", "User")"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><form asp-controller="User" asp-action="Logout" method="post"><button type="submit" class="nav-link border-0 bg-transparent"><i class="fas fa-sign-out-alt"></i> Logout</button></form></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container lab-page">
        <header class="catalogue-hero">
            <div>
                <h1>Shop the catalogue</h1>
                <p>Gaming consoles and handhelds.</p>
            </div>
            @if (productCount > 0)
            {
                <div class="catalogue-search" role="search" hidden>
                    <label for="catalogue-search">Find a product</label>
                    <input id="catalogue-search" type="search" class="form-control" placeholder="Search by name or description" autocomplete="off">
                </div>
            }
        </header>

        @if (productCount > 0)
        {
            <section aria-labelledby="catalogue-heading" data-add-url="@Url.Action("AddToCartAjax", "User")" data-cart-url="@Url.Action("Cart", "User")">
                <div class="catalogue-toolbar">
                    <h2 id="catalogue-heading">In stock</h2>
                    <output id="catalogue-count" for="catalogue-search" aria-live="polite">@productCount @(productCount == 1 ? "product" : "products")</output>
                </div>

                <div class="catalogue-grid">
                    @foreach (var product in Model)
                    {
                        <article class="product-card" data-catalogue-item data-product-id="@product.ProductID" data-stock="@product.Quantity">
                            <div class="product-img">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@(product.ImagePath.Split(',', 2)[0])" alt="" loading="lazy">
                                }
                                else
                                {
                                    <span class="catalogue-no-image"><i class="fas fa-box fa-2x" aria-hidden="true"></i><span class="visually-hidden">No product photo</span></span>
                                }
                            </div>
                            <div class="catalogue-details">
                                <h3 class="product-title">@product.ProductName</h3>
                                <p class="catalogue-description">@product.Description</p>
                                <div class="catalogue-price-row">
                                    <span class="product-price">RM @product.UnitPrice?.ToString("N2")</span>
                                    <span class="catalogue-stock">@product.Quantity in stock</span>
                                </div>
                                <div class="catalogue-actions">
                                    <div class="qty-controls input-group input-group-sm">
                                        <button type="button" class="qty-btn" data-quantity-step="-1" aria-label="Decrease quantity for @product.ProductName" disabled>−</button>
                                        <input type="text" class="qty-input form-control flex-grow-0" value="1" aria-label="Quantity for @product.ProductName" readonly>
                                        <button type="button" class="qty-btn" data-quantity-step="1" aria-label="Increase quantity for @product.ProductName" disabled>+</button>
                                    </div>
                                    <button class="btn-add-cart btn" type="button" disabled>Add to cart</button>
                                </div>
                                <div class="catalogue-feedback" role="status"></div>
                            </div>
                        </article>
                    }
                </div>
                <p class="lab-empty" id="catalogue-empty" hidden>No matching products. Try another search.</p>
            </section>
        }
        else
        {
            <p class="lab-empty">There are no products in stock right now.</p>
        }
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="~/js/session-guard.js"></script>
    <partial name="_AntiforgeryHeader" />
    <script src="~/js/shop-catalogue.js" asp-append-version="true"></script>
</body>
</html>
