@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-card" aria-labelledby="reset-title">
            <div class="auth-panel">
                <div class="auth-brand">Password recovery</div>
                <h1 id="reset-title">Reset seller password</h1>
                <p>Enter the email address associated with the seller account.</p>
                <div class="auth-alert error" id="errorAlert" role="alert"></div>
                <div class="auth-alert success" id="successAlert" role="status"></div>
                <form id="forgotForm">
                    @Html.AntiForgeryToken()
                    <div class="auth-field">
                        <label class="auth-label" for="resetEmail">Email address</label>
                        <input class="auth-input" id="resetEmail" name="email" type="email"
                               autocomplete="email" required>
                    </div>
                    <button class="auth-button" type="submit">Send OTP</button>
                </form>
                <div class="auth-links">
                    <a class="auth-link" href="@Url.Action("Login", "Seller")">Back to sign in</a>
                </div>
            </div>
        </section>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script>
        $("#forgotForm").on("submit", function (event) {
            event.preventDefault();
            const button = this.querySelector("button[type=submit]");
            button.disabled = true;
            $.ajax({
                url: '@Url.Action("ForgotPassword", "Seller")',
                type: "POST",
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $("#errorAlert").hide();
                        $("#successAlert").text("OTP sent. Redirecting.").show();
                        setTimeout(function () { window.location.href = '@Url.Action("OTP", "Seller")'; }, 700);
                    } else {
                        $("#successAlert").hide();
                        $("#errorAlert").text(response.message || "Reset request failed.").show();
                    }
                },
                error: function () {
                    $("#errorAlert").text("The server could not process the request.").show();
                },
                complete: function () { button.disabled = false; }
            });
        });
    </script>
</body>
</html>
