@using JQuery_ECommerceAss.Common.Enum
@model List<JQuery_ECommerceAss.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
    var liveCount = Model.Count(product => (product.ProductStatus is Status.Active or Status.Approve) && product.Quantity > 0);
    var pendingCount = Model.Count(product => product.ProductStatus == Status.Pending);
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/geek-lab.css" asp-append-version="true">
</head>
<body class="lab-area">
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Dashboard", "Seller")">Geek Lab <span class="lab-brand-role">Seller</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle seller navigation" aria-controls="navbarNav" aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "Seller")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" aria-current="page" href="@Url.Action("ManageProducts", "Seller")"><i class="fas fa-box"></i> Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("CustomerInsights", "Seller")"><i class="fas fa-users"></i> Customers</a></li>
                    <li class="nav-item"><form asp-controller="Seller" asp-action="Logout" method="post"><button type="submit" class="nav-link border-0 bg-transparent"><i class="fas fa-sign-out-alt"></i> Logout</button></form></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container lab-page">
        <header class="lab-page-header">
            <div>
                <h1>Manage Products</h1>
                <p>Review listing status, prices and available stock.</p>
            </div>
            <a asp-action="AddProduct" class="btn btn-primary">
                <i class="fas fa-plus" aria-hidden="true"></i> Add product
            </a>
        </header>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <dl class="inventory-overview">
            <div><dt>Listings</dt><dd>@Model.Count</dd></div>
            <div><dt>In shop</dt><dd>@liveCount</dd></div>
            <div><dt>Pending</dt><dd>@pendingCount</dd></div>
        </dl>

        @if (Model.Count == 0)
        {
            <p class="lab-empty">Your inventory is empty. Add a product to create your first listing.</p>
        }

        @foreach (var product in Model)
        {
            var statusClass = product.ProductStatus switch
            {
                Status.Active or Status.Approve => "live",
                Status.Pending => "pending",
                _ => "secondary"
            };
            var statusText = product.ProductStatus == Status.Approve ? "Approved" : product.ProductStatus?.ToString() ?? "Unknown";

            <article class="inventory-card">
                <div class="inventory-image">
                    @if (!string.IsNullOrEmpty(product.ImagePath))
                    {
                        <img src="@(product.ImagePath.Split(',', 2)[0])" alt="" loading="lazy">
                    }
                    else
                    {
                        <span class="inventory-no-image"><i class="fas fa-box" aria-hidden="true"></i><span class="visually-hidden">No product photo</span></span>
                    }
                </div>
                <div>
                    <h2>@product.ProductName</h2>
                    <span class="inventory-meta">Listing #@product.ProductID</span>
                </div>
                <div class="inventory-price-stock">
                    <span class="inventory-price">RM @product.UnitPrice?.ToString("N2")</span>
                    <span class="inventory-stock">@(product.Quantity is null or <= 0 ? "Out of stock" : $"{product.Quantity} in stock")</span>
                </div>
                <div><span class="inventory-status @statusClass">@statusText</span></div>
                <div class="inventory-actions">
                    <a asp-action="EditProduct" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-primary" aria-label="Edit @product.ProductName">Edit</a>
                    <a asp-action="DeleteProduct" asp-route-id="@product.ProductID" class="btn btn-sm btn-outline-danger" aria-label="Delete @product.ProductName">Delete</a>
                </div>
            </article>
        }
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>