@{
    ViewData["Title"] = "Seller Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
            max-width: 1000px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .login-hero {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
        }

        .hero-icon {
            font-size: 80px;
            margin-bottom: 30px;
        }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .login-form-section {
            padding: 60px 50px;
        }

        .nav-tabs {
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 30px;
        }

            .nav-tabs .nav-link {
                color: #6c757d;
                font-weight: 600;
                padding: 12px 24px;
                border: none;
                border-bottom: 3px solid transparent;
            }

                .nav-tabs .nav-link.active {
                    color: #f5576c;
                    background: transparent;
                    border-color: #f5576c;
                }

        .form-control {
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
        }

            .form-control:focus {
                border-color: #f5576c;
                box-shadow: 0 0 0 3px rgba(245, 87, 108, 0.1);
            }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
        }

        .btn-primary {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            border: none;
            padding: 14px;
            font-weight: 600;
            border-radius: 10px;
            width: 100%;
        }

            .btn-primary:hover {
                opacity: 0.9;
            }
        @@media (max-width: 768px) {
            .login-container

        {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-hero">
            <div class="hero-icon"><i class="fas fa-store"></i></div>
            <h1 class="hero-title">SELLER PORTAL</h1>
            <p class="text-center">Manage your products and grow your business with ease</p>
        </div>

        <div class="login-form-section">
            <h2 class="fw-bold mb-4">Welcome Back</h2>

            <div class="alert alert-success" id="successAlert" style="display: none;"></div>
            <div class="alert alert-danger" id="errorAlert" style="display: none;"></div>

            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#login">Login</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#register">Register</button></li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="login">
                    <form id="loginFormElement">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Username</label>
                            <input type="text" class="form-control" name="SellerUsername" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="position-relative">
                                <input type="password" class="form-control" id="loginPassword" name="SellerPassword" required>
                                <button type="button" class="password-toggle-btn" onclick="togglePassword('loginPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i> Sign In
                        </button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="@Url.Action("ForgotPassword", "Seller")" class="text-decoration-none">Forgot Password?</a>
                    </div>
                </div>

                <div class="tab-pane fade" id="register">
                    <form id="registerFormElement">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Username</label>
                            <input type="text" class="form-control" name="SellerUsername" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" name="SellerEmail" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="position-relative">
                                <input type="password" class="form-control" id="registerPassword" name="SellerPassword" required>
                                <button type="button" class="password-toggle-btn" onclick="togglePassword('registerPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <div class="position-relative">
                                <input type="password" class="form-control" id="confirmPassword" name="ConfirmPassword" required>
                                <button type="button" class="password-toggle-btn" onclick="togglePassword('confirmPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus me-2"></i> Create Account
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function showAlert(type, message) {
            $('.alert').hide();
            $(`#${type}Alert`).text(message).show();
            setTimeout(() => $('.alert').fadeOut(), 5000);
        }

        $('#loginFormElement').on('submit', function(e) {
            e.preventDefault();
            $.ajax({
                url: '@Url.Action("Login", "Seller")',
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        showAlert('success', 'Login successful!');
                        setTimeout(() => window.location.href = '@Url.Action("Dashboard", "Seller")', 1000);
                    } else {
                        showAlert('error', response.message || 'Login failed');
                    }
                }
            });
        });

        $('#registerFormElement').on('submit', function(e) {
            e.preventDefault();
            const data = {};
            $(this).serializeArray().forEach(item => data[item.name] = item.value);
            if (data.SellerPassword !== data.ConfirmPassword) {
                showAlert('error', 'Passwords do not match');
                return;
            }
            $.ajax({
                url: '@Url.Action("Register", "Seller")',
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        showAlert('success', 'Registration successful! Check your email.');
                        setTimeout(() => window.location.href = '@Url.Action("OTP", "Seller")', 2000);
                    } else {
                        showAlert('error', response.message || 'Registration failed');
                    }
                }
            });
        });
    </script>
</body>
</html>