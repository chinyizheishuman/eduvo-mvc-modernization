@{
    ViewData["Title"] = "Seller Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-modern.css" />
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-logo">
                    <div class="sidebar-logo-icon">
                        <i class="fas fa-store"></i>
                    </div>
                    <span class="sidebar-logo-text">E-Commerce</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Main Menu</h6>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-link">
                                <i class="fas fa-chart-line"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Index", "Admin")" class="sidebar-link">
                                <i class="fas fa-box"></i>
                                <span>Products</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("ManageUser", "Admin")" class="sidebar-link">
                                <i class="fas fa-users"></i>
                                <span>Users</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("ManageSeller", "Admin")" class="sidebar-link active">
                                <i class="fas fa-store-alt"></i>
                                <span>Sellers</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Account</h6>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Logout", "Admin")" class="sidebar-link">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            @if (Context.Session.GetString("LastLogin") != null)
            {
                <div class="sidebar-footer">
                    <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">
                        <i class="fas fa-clock"></i> Last Login
                    </div>
                    <div style="font-size: 0.875rem; font-weight: 600; color: #374151;">
                        @Context.Session.GetString("LastLogin")
                    </div>
                </div>
            }
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Top Bar -->
            <div class="admin-topbar">
                <div class="topbar-title">
                    <i class="fas fa-store-alt"></i>
                    Seller Management
                </div>
                <div class="topbar-actions">
                    <button class="btn btn-primary" onclick="$('#createSellerModal').show()">
                        <i class="fas fa-plus"></i>
                        Add Seller
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="admin-content">
                <!-- Search & Filter -->
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div class="search-box" style="max-width: 400px;">
                                <i class="fas fa-search"></i>
                                <input type="text" id="searchInput" placeholder="Search sellers by username, email...">
                            </div>
                            <div>
                                <span class="badge badge-primary" id="sellerCount" style="font-size: 0.9375rem; padding: 0.5rem 1rem;">
                                    Loading...
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Container -->
                <div id="alertContainer"></div>

                <!-- Sellers Table -->
                <div class="table-container">
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Registered</th>
                                    <th>Login Tries</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="sellersTableBody">
                                <tr>
                                    <td colspan="7" class="text-center" style="padding: 3rem;">
                                        <div class="spinner" style="margin: 0 auto;"></div>
                                        <p style="margin-top: 1rem; color: #6b7280;">Loading sellers...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Create Seller Modal -->
    <div class="modal fade" id="createSellerModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog">
                <div class="modal-header">
                    <h3 class="modal-title">Add New Seller</h3>
                    <button type="button" class="modal-close" onclick="$('#createSellerModal').hide()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="createSellerForm">
                        <div class="form-group">
                            <label class="form-label form-label-required">Username</label>
                            <input type="text" class="form-control" name="SellerUsername" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label form-label-required">Password</label>
                            <input type="password" class="form-control" name="SellerPassword" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label form-label-required">Email</label>
                            <input type="email" class="form-control" name="SellerEmail" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Seller Status</label>
                            <select class="form-control form-select" name="SellerStatus">
                                <option value="0">Active</option>
                                <option value="1">Inactive</option>
                                <option value="2">Pending</option>
                                <option value="3">Suspended</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="$('#createSellerModal').hide()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveSellerBtn">
                        <i class="fas fa-save"></i> Save Seller
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Seller Modal -->
    <div class="modal fade" id="editSellerModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog">
                <div class="modal-header">
                    <h3 class="modal-title">Edit Seller</h3>
                    <button type="button" class="modal-close" onclick="$('#editSellerModal').hide()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editSellerForm">
                        <input type="hidden" id="editSellerID" name="SellerID">
                        <div class="form-group">
                            <label class="form-label form-label-required">Username</label>
                            <input type="text" class="form-control" id="editSellerUsername" name="SellerUsername" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label form-label-required">Email</label>
                            <input type="email" class="form-control" id="editSellerEmail" name="SellerEmail" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-exclamation-triangle"></i> Login Attempts
                            </label>
                            <input type="number" class="form-control" id="editLoginTry" name="LoginTry" min="0" max="10">
                            <small class="form-help">
                                <i class="fas fa-info-circle"></i> Account locks at 3 failed attempts. Set to 0 to unlock.
                            </small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Seller Status</label>
                            <select class="form-control form-select" id="editSellerStatus" name="SellerStatus">
                                <option value="0">Active</option>
                                <option value="1">Inactive</option>
                                <option value="2">Pending</option>
                                <option value="3">Suspended</option>
                            </select>
                            <small class="form-help">
                                <i class="fas fa-lightbulb"></i> Changing from Suspended to Active will auto-reset login attempts
                            </small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="$('#editSellerModal').hide()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="updateSellerBtn">
                        <i class="fas fa-save"></i> Update Seller
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Details Modal -->
    <div class="modal fade" id="viewDetailsModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog">
                <div class="modal-header">
                    <h3 class="modal-title">Seller Details</h3>
                    <button type="button" class="modal-close" onclick="$('#viewDetailsModal').hide()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body" id="sellerDetailsContent"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="$('#viewDetailsModal').hide()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/session-guard.js"></script>
    <partial name="_AntiforgeryHeader" />

    <script>
        let allSellers = [];

        $(document).ready(function() {
            loadSellers();

            let searchTimeout;
            $('#searchInput').on('keyup', function() {
                clearTimeout(searchTimeout);
                const searchTerm = $(this).val();

                searchTimeout = setTimeout(function() {
                    if (searchTerm.length > 0) {
                        searchSellers(searchTerm);
                    } else {
                        renderSellers(allSellers);
                    }
                }, 300);
            });

            $('#saveSellerBtn').on('click', saveSeller);
            $('#updateSellerBtn').on('click', updateSeller);
        });

        function getStatusInfo(status) {
            const statusMap = {
                0: { text: 'Active', class: 'badge-success' },
                1: { text: 'Inactive', class: 'badge-secondary' },
                2: { text: 'Pending', class: 'badge-warning' },
                3: { text: 'Suspended', class: 'badge-danger' }
            };
            return statusMap[status] || { text: 'Unknown', class: 'badge-secondary' };
        }

        function loadSellers() {
            $.ajax({
                url: '@Url.Action("GetSellersJson", "Admin")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        allSellers = response.data;
                        renderSellers(allSellers);
                    } else {
                        showAlert('danger', response.message);
                        $('#sellersTableBody').html('<tr><td colspan="7" class="text-center">Failed to load sellers</td></tr>');
                        $('#sellerCount').text('0 sellers');
                    }
                },
                error: function() {
                    showAlert('danger', 'Error loading sellers');
                    $('#sellersTableBody').html('<tr><td colspan="7" class="text-center">Error loading sellers</td></tr>');
                    $('#sellerCount').text('0 sellers');
                }
            });
        }

        function renderSellers(sellers) {
            const tbody = $('#sellersTableBody');
            tbody.empty();

            if (sellers.length === 0) {
                tbody.append('<tr><td colspan="7" class="text-center" style="padding: 2rem; color: #6b7280;">No sellers found</td></tr>');
                $('#sellerCount').text('0 sellers');
                return;
            }

            $('#sellerCount').text(`${sellers.length} seller${sellers.length > 1 ? 's' : ''}`);

            sellers.forEach(seller => {
                const statusInfo = getStatusInfo(seller.sellerStatus);
                const registeredDate = seller.dateTime ? new Date(seller.dateTime).toLocaleDateString() : 'N/A';
                const loginTryBadge = seller.loginTry >= 3 ? `<span class="badge badge-danger"><i class="fas fa-lock"></i> ${seller.loginTry}</span>` : seller.loginTry || 0;

                const row = `
                    <tr>
                        <td>${seller.sellerID}</td>
                        <td><strong>${seller.sellerUsername || 'N/A'}</strong></td>
                        <td>${seller.sellerEmail || 'N/A'}</td>
                        <td><span class="badge ${statusInfo.class}">${statusInfo.text}</span></td>
                        <td>${registeredDate}</td>
                        <td>${loginTryBadge}</td>
                        <td>
                            <div class="table-actions">
                                <button class="btn btn-sm btn-icon btn-primary" onclick="viewDetails(${seller.sellerID})" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-icon btn-secondary" onclick="editSeller(${seller.sellerID})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-icon ${seller.sellerStatus === 0 ? 'btn-danger' : 'btn-success'}"
                                        onclick="toggleStatus(${seller.sellerID}, ${seller.sellerStatus})"
                                        title="${seller.sellerStatus === 0 ? 'Deactivate' : 'Activate'}">
                                    <i class="fas fa-${seller.sellerStatus === 0 ? 'ban' : 'check'}"></i>
                                </button>
                                <button class="btn btn-sm btn-icon btn-danger" onclick="deleteSeller(${seller.sellerID})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function searchSellers(searchTerm) {
            $.ajax({
                url: '@Url.Action("SearchSellers", "Admin")',
                type: 'GET',
                data: { searchTerm: searchTerm },
                success: function(response) {
                    if (response.success) {
                        renderSellers(response.data);
                    }
                }
            });
        }

        function saveSeller() {
            const formData = new FormData($('#createSellerForm')[0]);

            $.ajax({
                url: '@Url.Action("CreateSellerAjax", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        $('#createSellerModal').hide();
                        $('#createSellerForm')[0].reset();
                        loadSellers();
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function() {
                    showAlert('danger', 'Error creating seller');
                }
            });
        }

        function editSeller(sellerId) {
            const seller = allSellers.find(s => s.sellerID === sellerId);
            if (!seller) return;

            $('#editSellerID').val(seller.sellerID);
            $('#editSellerUsername').val(seller.sellerUsername);
            $('#editSellerEmail').val(seller.sellerEmail);
            $('#editLoginTry').val(seller.loginTry || 0);
            $('#editSellerStatus').val(seller.sellerStatus);

            $('#editSellerModal').show();
        }

        function updateSeller() {
            const formData = new FormData($('#editSellerForm')[0]);

            $.ajax({
                url: '@Url.Action("UpdateSellerAjax", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        $('#editSellerModal').hide();
                        loadSellers();
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function() {
                    showAlert('danger', 'Error updating seller');
                }
            });
        }

        function viewDetails(sellerId) {
            $.ajax({
                url: '@Url.Action("GetSellerDetailsJson", "Admin")',
                type: 'GET',
                data: { id: sellerId },
                success: function(response) {
                    if (response.success) {
                        const s = response.data;
                        const statusInfo = getStatusInfo(s.sellerStatus);
                        const registeredDate = s.registrationDate ? new Date(s.registrationDate).toLocaleDateString() : 'N/A';
                        const loginTryWarning = s.loginTry >= 3 ? '<span class="badge badge-danger"><i class="fas fa-exclamation-triangle"></i> Account Locked!</span>' : '';

                        const html = `
                            <div style="display: grid; gap: 1rem;">
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Seller ID:</strong>
                                    <p>${s.sellerID}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Username:</strong>
                                    <p>${s.sellerUsername || 'N/A'}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Email:</strong>
                                    <p>${s.sellerEmail || 'N/A'}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Status:</strong>
                                    <p><span class="badge ${statusInfo.class}">${statusInfo.text}</span></p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Registered Date:</strong>
                                    <p>${registeredDate}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Login Attempts:</strong>
                                    <p>${s.loginTry || 0} ${loginTryWarning}</p>
                                </div>
                            </div>
                        `;

                        $('#sellerDetailsContent').html(html);
                        $('#viewDetailsModal').show();
                    }
                }
            });
        }

        function toggleStatus(sellerId, currentStatus) {
            const newStatus = currentStatus === 0 ? 1 : 0;
            const action = newStatus === 1 ? 'deactivate' : 'activate';

            if (!confirm(`Are you sure you want to ${action} this seller?`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateSellerStatusAjax", "Admin")',
                type: 'POST',
                data: { id: sellerId, status: newStatus },
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        loadSellers();
                    } else {
                        showAlert('danger', response.message);
                    }
                }
            });
        }

        function deleteSeller(sellerId) {
            if (!confirm('Are you sure you want to delete this seller? This action cannot be undone.')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteSellerAjax", "Admin")',
                type: 'POST',
                data: { id: sellerId },
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        loadSellers();
                    } else {
                        showAlert('danger', response.message);
                    }
                }
            });
        }

        function showAlert(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'check-circle' : 'exclamation-circle';

            const alert = `
                <div class="alert ${alertClass}">
                    <i class="fas fa-${icon}"></i>
                    <span>${message}</span>
                </div>
            `;

            $('#alertContainer').html(alert);

            setTimeout(function() {
                $('.alert').fadeOut(function() {
                    $(this).remove();
                });
            }, 5000);
        }
    </script>
</body>
</html>