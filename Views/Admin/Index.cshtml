@{
    ViewData["Title"] = "Product Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin-modern.css" />
    <style>
        .product-thumbnail {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #e5e7eb;
        }

        .image-preview-container {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-top: 0.75rem;
        }

        .image-preview-item {
            position: relative;
            width: 100px;
            height: 100px;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #e5e7eb;
        }

            .image-preview-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .remove-image {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 24px;
            height: 24px;
            background: #ef4444;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-logo">
                    <div class="sidebar-logo-icon">
                        <i class="fas fa-store"></i>
                    </div>
                    <span class="sidebar-logo-text">E-Commerce</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Main Menu</h6>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-link">
                                <i class="fas fa-chart-line"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Index", "Admin")" class="sidebar-link active">
                                <i class="fas fa-box"></i>
                                <span>Products</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("ManageUser", "Admin")" class="sidebar-link">
                                <i class="fas fa-users"></i>
                                <span>Users</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("ManageSeller", "Admin")" class="sidebar-link">
                                <i class="fas fa-store-alt"></i>
                                <span>Sellers</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h6 class="sidebar-section-title">Account</h6>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="@Url.Action("Logout", "Admin")" class="sidebar-link">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            @if (Context.Session.GetString("LastLogin") != null)
            {
                <div class="sidebar-footer">
                    <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">
                        <i class="fas fa-clock"></i> Last Login
                    </div>
                    <div style="font-size: 0.875rem; font-weight: 600; color: #374151;">
                        @Context.Session.GetString("LastLogin")
                    </div>
                </div>
            }
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Top Bar -->
            <div class="admin-topbar">
                <div class="topbar-title">
                    <i class="fas fa-box"></i>
                    Product Management
                </div>
                <div class="topbar-actions">
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
                        <i class="fas fa-plus"></i>
                        Add Product
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="admin-content">
                <!-- Search & Filter -->
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div class="search-box" style="max-width: 400px;">
                                <i class="fas fa-search"></i>
                                <input type="text" id="searchInput" placeholder="Search products by name, description, seller...">
                            </div>
                            <div>
                                <span class="badge badge-primary" id="productCount" style="font-size: 0.9375rem; padding: 0.5rem 1rem;">
                                    Loading...
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Alert Container -->
                <div id="alertContainer"></div>

                <!-- Products Table -->
                <div class="table-container">
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Seller</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <tr>
                                    <td colspan="9" class="text-center" style="padding: 3rem;">
                                        <div class="spinner" style="margin: 0 auto;"></div>
                                        <p style="margin-top: 1rem; color: #6b7280;">Loading products...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Create Product Modal -->
    <div class="modal fade" id="createProductModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog" style="max-width: 700px;">
                <div class="modal-header">
                    <h3 class="modal-title">Add New Product</h3>
                    <button type="button" class="modal-close" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="createProductForm" enctype="multipart/form-data">
                        <div class="form-group">
                            <label class="form-label form-label-required">Product Name</label>
                            <input type="text" class="form-control" name="ProductName" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="Description" rows="3"></textarea>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label class="form-label form-label-required">Unit Price (RM)</label>
                                <input type="number" class="form-control" name="UnitPrice" step="0.01" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required">Quantity</label>
                                <input type="number" class="form-control" name="Quantity" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label form-label-required">Seller</label>
                            <select class="form-control form-select" name="SellerID" id="sellerSelect" required>
                                <option value="">-- Select Seller --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Product Status</label>
                            <select class="form-control form-select" name="ProductStatus">
                                <option value="0">Active</option>
                                <option value="1">Inactive</option>
                                <option value="2">Pending</option>
                                <option value="3">Suspended</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Product Images (Multiple)</label>
                            <input type="file" class="form-control form-file" id="productImages" name="images" multiple accept="image/*">
                            <div id="imagePreviewContainer" class="image-preview-container"></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveProductBtn">
                        <i class="fas fa-save"></i> Save Product
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Product Modal -->
    <div class="modal fade" id="editProductModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog" style="max-width: 700px;">
                <div class="modal-header">
                    <h3 class="modal-title">Edit Product</h3>
                    <button type="button" class="modal-close" onclick="$('#editProductModal').hide()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="editProductForm" enctype="multipart/form-data">
                        <input type="hidden" id="editProductID" name="ProductID">
                        <div class="form-group">
                            <label class="form-label form-label-required">Product Name</label>
                            <input type="text" class="form-control" id="editProductName" name="ProductName" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" id="editDescription" name="Description" rows="3"></textarea>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                <label class="form-label form-label-required">Unit Price (RM)</label>
                                <input type="number" class="form-control" id="editUnitPrice" name="UnitPrice" step="0.01" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required">Quantity</label>
                                <input type="number" class="form-control" id="editQuantity" name="Quantity" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label form-label-required">Seller</label>
                            <select class="form-control form-select" id="editSellerID" name="SellerID" required>
                                <option value="">-- Select Seller --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Product Status</label>
                            <select class="form-control form-select" id="editProductStatus" name="ProductStatus">
                                <option value="0">Active</option>
                                <option value="1">Inactive</option>
                                <option value="2">Pending</option>
                                <option value="3">Suspended</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Current Images</label>
                            <div id="currentImagesContainer" class="image-preview-container"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Upload New Images (Optional)</label>
                            <input type="file" class="form-control form-file" id="editProductImages" name="images" multiple accept="image/*">
                            <div id="editImagePreviewContainer" class="image-preview-container"></div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="$('#editProductModal').hide()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="updateProductBtn">
                        <i class="fas fa-save"></i> Update Product
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Details Modal -->
    <div class="modal fade" id="viewDetailsModal" tabindex="-1" style="display: none;">
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999;">
            <div class="modal-dialog">
                <div class="modal-header">
                    <h3 class="modal-title">Product Details</h3>
                    <button type="button" class="modal-close" onclick="$('#viewDetailsModal').hide()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body" id="productDetailsContent"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="$('#viewDetailsModal').hide()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_AntiforgeryHeader" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    <script>
        let allProducts = [];
        let allSellers = [];

        $(document).ready(function() {
            loadProducts();
            loadSellers();

            let searchTimeout;
            $('#searchInput').on('keyup', function() {
                clearTimeout(searchTimeout);
                const searchTerm = $(this).val();

                searchTimeout = setTimeout(function() {
                    if (searchTerm.length > 0) {
                        searchProducts(searchTerm);
                    } else {
                        renderProducts(allProducts);
                    }
                }, 300);
            });

            $('#productImages').on('change', function(e) {
                handleImagePreview(e.target.files, 'imagePreviewContainer');
            });

            $('#editProductImages').on('change', function(e) {
                handleImagePreview(e.target.files, 'editImagePreviewContainer');
            });

            $('#saveProductBtn').on('click', saveProduct);
            $('#updateProductBtn').on('click', updateProduct);

            // Modal handlers
            $('[data-bs-toggle="modal"]').on('click', function() {
                const target = $(this).data('bs-target');
                $(target).show();
            });

            $('[data-bs-dismiss="modal"]').on('click', function() {
                $(this).closest('.modal').hide();
            });
        });

        function getStatusInfo(status) {
            const statusMap = {
                0: { text: 'Active', class: 'badge-success' },
                1: { text: 'Inactive', class: 'badge-secondary' },
                2: { text: 'Pending', class: 'badge-warning' },
                3: { text: 'Suspended', class: 'badge-danger' }
            };
            return statusMap[status] || { text: 'Unknown', class: 'badge-secondary' };
        }

        function loadProducts() {
            $.ajax({
                url: '@Url.Action("GetProductsJson", "Admin")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        allProducts = response.data;
                        renderProducts(allProducts);
                    } else {
                        showAlert('danger', response.message);
                        $('#productsTableBody').html('<tr><td colspan="9" class="text-center">Failed to load products</td></tr>');
                        $('#productCount').text('0 products');
                    }
                },
                error: function() {
                    showAlert('danger', 'Error loading products');
                    $('#productsTableBody').html('<tr><td colspan="9" class="text-center">Error loading products</td></tr>');
                    $('#productCount').text('0 products');
                }
            });
        }

        function loadSellers() {
            $.ajax({
                url: '@Url.Action("GetSellersJson", "Admin")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        allSellers = response.data;
                        const selects = $('#sellerSelect, #editSellerID');
                        selects.find('option:not(:first)').remove();
                        response.data.forEach(seller => {
                            selects.append(`<option value="${seller.sellerID}">${seller.sellerUsername}</option>`);
                        });
                    }
                }
            });
        }

        function renderProducts(products) {
            const tbody = $('#productsTableBody');
            tbody.empty();

            if (products.length === 0) {
                tbody.append('<tr><td colspan="9" class="text-center" style="padding: 2rem; color: #6b7280;">No products found</td></tr>');
                $('#productCount').text('0 products');
                return;
            }

            $('#productCount').text(`${products.length} product${products.length > 1 ? 's' : ''}`);

            products.forEach(product => {
                const statusInfo = getStatusInfo(product.productStatus);
                const imageUrl = product.imagePath ? product.imagePath.split(',')[0] : '/images/no-image.png';
                const description = product.description ? (product.description.length > 50 ? product.description.substring(0, 50) + '...' : product.description) : 'N/A';

                const row = `
                    <tr>
                        <td>${product.productID}</td>
                        <td><img src="${imageUrl}" class="product-thumbnail" alt="${product.productName}"></td>
                        <td><strong>${product.productName || 'N/A'}</strong></td>
                        <td>${description}</td>
                        <td><strong style="color: #2563eb;">RM ${(product.unitPrice || 0).toFixed(2)}</strong></td>
                        <td>${product.quantity || 0}</td>
                        <td>${product.sellerName}</td>
                        <td><span class="badge ${statusInfo.class}">${statusInfo.text}</span></td>
                        <td>
                            <div class="table-actions">
                                <button class="btn btn-sm btn-icon btn-primary" onclick="viewDetails(${product.productID})" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-icon btn-secondary" onclick="editProduct(${product.productID})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-icon ${product.productStatus === 0 ? 'btn-danger' : 'btn-success'}"
                                        onclick="toggleStatus(${product.productID}, ${product.productStatus})"
                                        title="${product.productStatus === 0 ? 'Deactivate' : 'Activate'}">
                                    <i class="fas fa-${product.productStatus === 0 ? 'ban' : 'check'}"></i>
                                </button>
                                <button class="btn btn-sm btn-icon btn-danger" onclick="deleteProduct(${product.productID})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function searchProducts(searchTerm) {
            $.ajax({
                url: '@Url.Action("SearchProducts", "Admin")',
                type: 'GET',
                data: { searchTerm: searchTerm },
                success: function(response) {
                    if (response.success) {
                        renderProducts(response.data);
                    }
                }
            });
        }

        function saveProduct() {
            const formData = new FormData($('#createProductForm')[0]);
            const files = $('#productImages')[0].files;

            for (let i = 0; i < files.length; i++) {
                formData.append('images', files[i]);
            }

            $.ajax({
                url: '@Url.Action("CreateProductAjax", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        $('#createProductModal').hide();
                        $('#createProductForm')[0].reset();
                        $('#imagePreviewContainer').empty();
                        loadProducts();
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function() {
                    showAlert('danger', 'Error creating product');
                }
            });
        }

        function editProduct(productId) {
            const product = allProducts.find(p => p.productID === productId);
            if (!product) return;

            $('#editProductID').val(product.productID);
            $('#editProductName').val(product.productName);
            $('#editDescription').val(product.description);
            $('#editUnitPrice').val(product.unitPrice);
            $('#editQuantity').val(product.quantity);
            $('#editSellerID').val(product.sellerID);
            $('#editProductStatus').val(product.productStatus);

            const currentImagesContainer = $('#currentImagesContainer');
            currentImagesContainer.empty();
            if (product.imagePath) {
                const images = product.imagePath.split(',');
                images.forEach(img => {
                    currentImagesContainer.append(`
                        <div class="image-preview-item">
                            <img src="${img}" alt="Product Image">
                        </div>
                    `);
                });
            }

            $('#editImagePreviewContainer').empty();
            $('#editProductModal').show();
        }

        function updateProduct() {
            const formData = new FormData($('#editProductForm')[0]);
            const files = $('#editProductImages')[0].files;

            for (let i = 0; i < files.length; i++) {
                formData.append('images', files[i]);
            }

            $.ajax({
                url: '@Url.Action("UpdateProductAjax", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        $('#editProductModal').hide();
                        loadProducts();
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function() {
                    showAlert('danger', 'Error updating product');
                }
            });
        }

        function viewDetails(productId) {
            $.ajax({
                url: '@Url.Action("GetProductDetailsJson", "Admin")',
                type: 'GET',
                data: { id: productId },
                success: function(response) {
                    if (response.success) {
                        const p = response.data;
                        const statusInfo = getStatusInfo(p.productStatus);

                        let imagesHtml = '';
                        if (p.imagePath) {
                            const images = p.imagePath.split(',');
                            images.forEach(img => {
                                imagesHtml += `<img src="${img}" class="product-thumbnail" style="width: 80px; height: 80px; margin-right: 0.5rem;" alt="Product">`;
                            });
                        }

                        const html = `
                            <div style="display: grid; gap: 1rem;">
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Images:</strong>
                                    <div style="margin-top: 0.5rem;">${imagesHtml || '<p>No images</p>'}</div>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Product ID:</strong>
                                    <p>${p.productID}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Product Name:</strong>
                                    <p>${p.productName || 'N/A'}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Description:</strong>
                                    <p>${p.description || 'N/A'}</p>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                    <div>
                                        <strong style="color: #6b7280; font-size: 0.875rem;">Unit Price:</strong>
                                        <p style="color: #2563eb; font-weight: 600;">RM ${(p.unitPrice || 0).toFixed(2)}</p>
                                    </div>
                                    <div>
                                        <strong style="color: #6b7280; font-size: 0.875rem;">Quantity:</strong>
                                        <p>${p.quantity || 0}</p>
                                    </div>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Seller:</strong>
                                    <p>${p.sellerName}</p>
                                </div>
                                <div>
                                    <strong style="color: #6b7280; font-size: 0.875rem;">Status:</strong>
                                    <p><span class="badge ${statusInfo.class}">${statusInfo.text}</span></p>
                                </div>
                            </div>
                        `;

                        $('#productDetailsContent').html(html);
                        $('#viewDetailsModal').show();
                    }
                }
            });
        }

        function toggleStatus(productId, currentStatus) {
            const newStatus = currentStatus === 0 ? 1 : 0;
            const action = newStatus === 1 ? 'deactivate' : 'activate';

            if (!confirm(`Are you sure you want to ${action} this product?`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateProductStatusAjax", "Admin")',
                type: 'POST',
                data: { id: productId, status: newStatus },
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        loadProducts();
                    } else {
                        showAlert('danger', response.message);
                    }
                }
            });
        }

        function deleteProduct(productId) {
            if (!confirm('Are you sure you want to delete this product? This action cannot be undone.')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteProductAjax", "Admin")',
                type: 'POST',
                data: { id: productId },
                success: function(response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        loadProducts();
                    } else {
                        showAlert('danger', response.message);
                    }
                }
            });
        }

        function handleImagePreview(files, containerId) {
            const container = $(`#${containerId}`);
            container.empty();

            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    container.append(`
                        <div class="image-preview-item" data-index="${index}">
                            <img src="${e.target.result}" alt="Preview">
                            <button type="button" class="remove-image" onclick="removeImagePreview('${containerId}', ${index})">×</button>
                        </div>
                    `);
                };
                reader.readAsDataURL(file);
            });
        }

        function removeImagePreview(containerId, index) {
            $(`#${containerId} .image-preview-item[data-index="${index}"]`).remove();
        }

        function showAlert(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'check-circle' : 'exclamation-circle';

            const alert = `
                <div class="alert ${alertClass}">
                    <i class="fas fa-${icon}"></i>
                    <span>${message}</span>
                </div>
            `;

            $('#alertContainer').html(alert);

            setTimeout(function() {
                $('.alert').fadeOut(function() {
                    $(this).remove();
                });
            }, 5000);
        }
    </script>
</body>
</html>